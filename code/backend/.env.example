# PostgreSQL connection string injected by the runtime.
DATABASE_URL=postgres://app:app_secret@localhost:5432/app?sslmode=disable

# API listen port. The backend falls back to APP_PORT, then 8080.
PORT=8080

# Optional fallback API listen port.
APP_PORT=8080

# Optional local-only switch for disabling per-IP API rate limiting.
RATE_LIMIT_DISABLED=false
