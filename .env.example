# Local Postgres user for Docker Compose.
POSTGRES_USER=app

# Local Postgres password for Docker Compose.
POSTGRES_PASSWORD=app_secret

# Local Postgres database for Docker Compose.
POSTGRES_DB=app

# Host port mapped to backend container port 8080.
BACKEND_PORT=8080

# Host port mapped to frontend container port 3000.
FRONTEND_PORT=3000

# Browser-visible REST API base URL baked into frontend bundle.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional image repository prefix for compose.
IMAGE_REPO=local

# Optional image tag for compose.
IMAGE_TAG=dev
